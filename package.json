{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run build:tools",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"update:neondeck": "rm -rf node_modules/@cyberpunk-apps/neondeck && npm install",
		"todo": "grep -rnE \"‹|TODO\\\\(content\\\\)\" src --include=*.ts --include=*.svelte --include=*.md | sed -E \"s/^([^:]+:[0-9]+):\\s*/\\1  /\"; echo; echo \"$(grep -rcE \"‹\" src --include=*.ts --include=*.svelte --include=*.md | awk -F: \"{s+=\\$2} END {print s}\") placeholder lines left\"",
		"build:site": "vite build",
		"build:tools": "bash scripts/build-tools.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@cyberpunk-apps/neondeck": "file:../sharable_assets/neondeck",
		"gray-matter": "^4.0.3",
		"marked": "^18.0.14",
		"shiki": "^4.5.0"
	}
}
